# Copy this file to .env and fill in your values
# Never commit .env to git

# OpenAI — required for the SH planner and escalation
OPENAI_API_KEY=sk-your-key-here

# Featherless — required for the default Senior workers (zai-org/GLM-5.3)
FEATHERLESS_API_KEY=your-featherless-key-here

# NVIDIA NIM — required for the Llama 3.3 Extractor
NIM_API_KEY=nvapi-your-key-here

# Splunk Enterprise connection (defaults work for a local install)
SPLUNK_HOST=https://localhost:8089
SPLUNK_USER=admin
SPLUNK_PASS=your_splunk_password_here

# LangSmith tracing (optional but recommended) — get a key at https://smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=botsv3-v1  # overridden per-run to botsv3-run_1.x / botsv3-test_<ts>
