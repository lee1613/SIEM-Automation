# Copy this file to .env and fill in your values
# Never commit .env to git

# NVIDIA NIM API key — get one at https://build.nvidia.com
NIM_API_KEY=nvapi-your-key-here

# Splunk Enterprise connection (defaults work for a local install)
SPLUNK_HOST=https://localhost:8089
SPLUNK_USER=admin
SPLUNK_PASS=your_splunk_password_here

# LangSmith tracing (optional but recommended) — get a key at https://smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=botsv3-v1  # overridden per-run to botsv3-run_1.x / botsv3-test_<ts>
